{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "thenoisemakers.pl"
        }
      ],
      "destination": "https://www.thenoisemakers.pl/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "en.thenoisemakers.pl"
        }
      ],
      "destination": "https://www.thenoisemakers.pl/en/index.html",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "thenoisemakers.pl"
        }
      ],
      "destination": "https://www.thenoisemakers.pl/:path*",
      "permanent": true
    },
